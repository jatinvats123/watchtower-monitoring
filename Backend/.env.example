# ---- core ----
PORT=8000
MONGO_URL=mongodb://localhost:27017/watchtower
NODE_ENV=development

# ---- auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=1d

# ---- urls / cors ----
FRONTEND_URL=http://localhost:5173
# Comma-separated allow-list. Never use a wildcard in production.
CORS_ORIGIN=http://localhost:5173

# ---- mail (incident notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# ---- ai (optional; incident summaries degrade gracefully if unset) ----
MISTRAL_API_KEY=your-mistral-api-key

# ---- security ----
# Encrypts outbound monitor credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Without it, monitors cannot store auth headers at all — storing them errors
# rather than silently writing plaintext. See SECURITY.md T4.
CREDENTIALS_ENCRYPTION_KEY=

# Registration currently marks accounts verified immediately, skipping the OTP
# email flow. Set to false to require real email verification.
# See SECURITY.md §5 item 1 — this is an accepted, documented risk.
AUTO_VERIFY_USERS=true

# Monitors and webhooks may not reach loopback, private, link-local or other
# internal addresses (the SSRF guard, see README "Security"). Set to true ONLY on
# a self-hosted instance that must monitor internal services, and only if you
# trust everyone who can sign up.
ALLOW_PRIVATE_TARGETS=false

# ---- scheduler (all optional; defaults shown) ----
# See docs/SCHEDULER.md for the full behavioural contract.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000
SCHEDULER_CONCURRENCY=10
SCHEDULER_LOCK_TTL_MS=30000
SCHEDULER_SHUTDOWN_GRACE_MS=10000

# ---- per-check retry ladder ----
CHECK_MAX_RETRIES=2
CHECK_RETRY_BASE_MS=250
CHECK_RETRY_CAP_MS=4000

# ---- circuit breaker ----
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=60000
BREAKER_MAX_COOLDOWN_MS=900000

# ---- retention ----
# TTL on the logs collection, in days. Must be >= the widest uptime window (30d).
LOG_RETENTION_DAYS=30

# ---- observability (see docs/RUNBOOK.md) ----
# pino level: fatal|error|warn|info|http|debug|trace
LOG_LEVEL=info
# Write log FILES as well as stdout. Off by default: in a container these are
# invisible to `docker logs` and discarded when the container is replaced.
LOG_TO_FILE=false
# Require `Authorization: Bearer <token>` on /metrics. Left unset the endpoint is
# open — a scrape endpoint that 401s at an unconfigured scraper looks exactly
# like a service that is down. Set this in production.
METRICS_TOKEN=

# ---- Google Sign-In (optional) ----
# Leave EMPTY to disable Google sign-in entirely. When empty: the /api/auth/google
# route answers 501, the login button is not rendered, and the Content-Security-
# Policy keeps its strict `script-src 'self'` default. Nothing is loosened for a
# feature that is switched off.
#
# Not a secret — it is embedded in the page by design — but it IS required
# server-side: verifying an ID token means checking its `aud` claim equals this
# value. Without that, a token minted for any other Google application would be
# accepted.
#
# Get one at https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Web application
#   Authorised JavaScript origins:
#     http://localhost:5173                          (Vite dev server)
#     http://localhost:5000                          (backend serving the SPA)
#     https://watchtower-monitoring.onrender.com     (production)
#   No redirect URI is needed: Google Identity Services returns the credential
#   to the page, it does not redirect anywhere.
#
# The SAME value must also be set as VITE_GOOGLE_CLIENT_ID for the frontend.
GOOGLE_CLIENT_ID=

# ---- outbound email transport ----
# Two paths are supported and the choice is made here, not in code:
#   BREVO_API_KEY set -> HTTPS on 443   (required wherever SMTP is blocked)
#   unset             -> SMTP on 587    (fine locally and on hosts that allow it)
#
# This exists because Render's FREE web services block outbound traffic on ports
# 25, 465 and 587 (their changelog, late September 2025). The symptom is
# invisible: /api/auth/forgot-password answers 200 whether or not delivery
# succeeded — deliberately, so it cannot be used to enumerate accounts — so a
# blocked port means users simply never receive anything, with no error anywhere
# they can see. Check /api/health/ready to see which transport is active.
#
# Free key: https://app.brevo.com -> SMTP & API -> API Keys (300 emails/day)
BREVO_API_KEY=

# Envelope sender. MUST be an address verified with the provider — Brevo rejects
# an unverified sender outright. Defaults to SMTP_USER when unset.
# Previously hardcoded to noreply@hackathon.com, a domain nobody here owns; it
# only ever appeared to work because Gmail rewrites From to the authenticated
# account, and any receiver checking DMARC alignment would treat it as forged.
MAIL_FROM=
MAIL_FROM_NAME=WatchTower
